{
  "source_root": ".",
  "modules": {
    "SAMPLE": [
      "sample/src",
      "sample/db",
      "sample/config"
    ]
  },
  "target_lines": 400,
  "max_lines": 1200,
  "item_kinds": [
    "if",
    "case",
    "ternary",
    "catch",
    "loop",
    "calc",
    "constant",
    "sql",
    "method",
    "config"
  ],
  "execution": {
    "enabled": true,
    "javac": "javac",
    "java": "java",
    "classpath": [],
    "encoding": "",
    "timeout_seconds": 20
  },
  "runner": {
    "command": [
      "claude",
      "-p",
      "--model",
      "{model}",
      "--permission-mode",
      "acceptEdits",
      "--allowedTools",
      "Read,Glob,Grep,Write,Edit"
    ],
    "models": {
      "extract": "sonnet",
      "verify": "opus",
      "resolve": "opus",
      "overview": "opus",
      "recheck": "sonnet",
      "calibrate": "opus"
    },
    "parallel": 3,
    "max_calls_per_item": 6,
    "timeout_minutes": 30,
    "runner_failures_before_stop": 3,
    "retry_wait_seconds": 30
  }
}